# Copy to .env or run ./scripts/install.sh --apply to generate secrets.
DGX_SECRET_KEY=replace-with-at-least-32-random-characters
DGX_ADMIN_USERNAME=admin
DGX_ADMIN_PASSWORD=replace-with-a-long-random-password
DGX_COOKIE_SECURE=false
DGX_ALLOWED_ORIGINS=http://dgx-spark.local:3000

PUID=1000
PGID=1000
DOCKER_GID=988
HF_HOME_HOST=/home/your-user/.cache/huggingface
MODEL_HOME_HOST=/home/your-user/models
