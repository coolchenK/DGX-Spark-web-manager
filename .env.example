# Copy to .env or run ./scripts/install.sh --apply to generate secrets.
DGX_SECRET_KEY=replace-with-at-least-32-random-characters
DGX_ADMIN_USERNAME=admin
DGX_ADMIN_PASSWORD=replace-with-a-long-random-password
DGX_COOKIE_SECURE=false
DGX_ALLOWED_ORIGINS=http://dgx-spark.local:3000
DGX_DEPLOYMENT_STARTUP_TIMEOUT_SECONDS=1200
DGX_LISTEN_HOST=0.0.0.0
DGX_LISTEN_PORT=3000

PUID=1000
PGID=1000
DOCKER_GID=988
OPS_AGENT_GID=989
HF_HOME_HOST=/home/your-user/.cache/huggingface
MODEL_HOME_HOST=/home/your-user/models
LLAMA_CPP_HOME_HOST=/opt/llamacpp

DGX_OPS_AGENT_SOCKET=/run/dgx-spark-manager/ops-agent.sock
DGX_OPS_AGENT_KEY_FILE=/run/secrets/ops-agent.key
DGX_OPS_AGENT_CONNECT_TIMEOUT_SECONDS=3
DGX_OPS_AGENT_READ_TIMEOUT_SECONDS=30
DGX_OPS_AGENT_OUTPUT_LIMIT_BYTES=1000000

# Optional: upstream OpenAI-compatible gateway used for models this manager does
# not host. Requests for unknown model routes are forwarded verbatim, and the
# upstream models are listed by /v1/models next to the local ones.
# These values are only the default seed: the panel (API 网关 -> 上游网关) stores
# its own encrypted configuration, which wins over these variables and takes
# effect without rebuilding the container.
DGX_FALLBACK_BASE_URL=
DGX_FALLBACK_API_KEY=
# Seconds to cache the upstream model list. Defaults to 30.
DGX_UPSTREAM_MODELS_CACHE_SECONDS=30
# Sampling window for the gateway token-throughput reading. Defaults to 300;
# a one-minute window reads zero for interactive workloads that pause between turns.
DGX_GATEWAY_THROUGHPUT_WINDOW_SECONDS=300
